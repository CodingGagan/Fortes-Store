<div class="customer">
  <div class="customer__block">
    <h1 class="customer__title">Reset your password</h1>
    <p class="customer__subtitle">Enter a new password for your account.</p>

    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <ul class="customer__errors">
          {% for field in form.errors %}
            <li>{{ form.errors.translated_fields[field] | capitalize }}: {{ form.errors.messages[field] }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      <div class="customer__form">
        <div class="customer__field">
          <label for="reset-password">New password</label>
          <input type="password" name="customer[password]" id="reset-password" autocomplete="new-password" required>
        </div>
        <div class="customer__field">
          <label for="reset-password-confirm">Confirm password</label>
          <input type="password" name="customer[password_confirmation]" id="reset-password-confirm" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button customer__button">Reset password</button>
      </div>
    {% endform %}
  </div>
</div>
