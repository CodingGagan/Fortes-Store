<footer class="footer">
  <div class="footer__top">
    <div class="footer__newsletter">
      <h3 class="footer__newsletter-title">{{ section.settings.newsletter_heading }}</h3>

      {% form 'customer', class: 'footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}
          <p class="footer__form-success">{{ section.settings.newsletter_success }}</p>
        {% else %}
          <div class="footer__form-row">
            <input
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.newsletter_placeholder }}"
              aria-label="{{ section.settings.newsletter_placeholder }}"
              required
            >
            <button type="submit" class="button footer__form-button">
              {{ section.settings.newsletter_button }}
            </button>
          </div>
        {% endif %}
      {% endform %}

      {% if section.settings.newsletter_disclaimer != blank %}
        <p class="footer__disclaimer">{{ section.settings.newsletter_disclaimer }}</p>
      {% endif %}
    </div>

    <div class="footer__menus">
      {% for block in section.blocks %}
        <div class="footer__menu" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h4 class="footer__menu-title">{{ block.settings.heading }}</h4>
          {% endif %}
          <ul class="footer__menu-list">
            {% for link in block.settings.menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>{{ powered_by_link }}</span>
  </div>
</footer>

{% stylesheet %}
  .footer {
    margin-top: 4rem;
    padding: 4rem var(--page-margin) 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .footer__newsletter-title {
    font-size: 1.6rem;
    margin: 0 0 1.25rem;
  }

  .footer__form-row {
    display: flex;
    gap: 0.5rem;
    max-width: 360px;
  }

  .footer__form-row input {
    flex: 1;
    padding: 0.6rem 0.9rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .footer__disclaimer {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    opacity: 0.6;
    max-width: 360px;
  }

  .footer__menus {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    justify-content: flex-end;
  }

  .footer__menu-title {
    font-family: var(--font-primary--family);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.6;
    margin: 0 0 1rem;
  }

  .footer__menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer__menu-list a,
  .footer a {
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    font-size: 0.8rem;
    opacity: 0.6;
  }

  @media (max-width: 749px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer__menus {
      justify-content: flex-start;
      gap: 2.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join our mailing list"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "textarea",
      "id": "newsletter_disclaimer",
      "label": "Disclaimer",
      "default": "By subscribing, you agree to receive marketing emails. Consult our Terms of Use."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
