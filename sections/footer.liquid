<footer class="footer">
  <div class="footer__top">
    <div class="footer__newsletter">
      <h3 class="footer__newsletter-title">{{ section.settings.newsletter_heading }}</h3>

      {% form 'customer', class: 'footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}
          <p class="footer__form-success">{{ section.settings.newsletter_success }}</p>
        {% else %}
          <div class="footer__form-row">
            <input
              type="email"
              name="contact[email]"
              class="footer__form-input"
              placeholder="{{ section.settings.newsletter_placeholder }}"
              aria-label="{{ section.settings.newsletter_placeholder }}"
              required
            >
            {% if section.settings.newsletter_disclaimer != blank %}
              <p class="footer__disclaimer">{{ section.settings.newsletter_disclaimer }}</p>
            {% endif %}
            <button type="submit" class="footer__form-button">
              {{ section.settings.newsletter_button }}
            </button>
          </div>
        {% endif %}
      {% endform %}
    </div>

    <nav class="footer__menus" aria-label="Footer">
      {% for block in section.blocks %}
        <div class="footer__menu" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h4 class="footer__menu-title">{{ block.settings.heading }}</h4>
          {% endif %}
          <ul class="footer__menu-list">
            {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
              {% for link in block.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% elsif forloop.first %}
              {% comment %} Fallback links until a navigation menu is assigned in admin. {% endcomment %}
              <li><a href="{{ pages['about-us'].url | default: '/pages/about-us' }}">About Us</a></li>
              <li><a href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}">Contact</a></li>
            {% endif %}
          </ul>
        </div>
      {% endfor %}

      <div class="footer__account">
        <a href="{{ routes.account_login_url }}" class="footer__signin">
          {{ section.settings.signin_label | default: 'Sign In' }}
        </a>
      </div>
    </nav>
  </div>

  <div class="footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>{{ powered_by_link }}</span>
  </div>
</footer>

{% stylesheet %}
  .footer {
    margin-top: 4rem;
    padding: 5rem var(--page-margin) 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(320px, 1fr) auto;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  /* ---------- Newsletter ---------- */
  .footer__newsletter {
    max-width: 460px;
  }

  .footer__newsletter-title {
    font-family: var(--font-product, 'Ovo', serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.1;
    margin: 0 0 1.75rem;
  }

  .footer__form-row {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .footer__form-input {
    width: 100%;
    padding: 1.15rem 1.1rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: 1rem;
  }

  .footer__form-input:focus {
    outline: none;
    border-color: rgba(0, 0, 0, 0.4);
  }

  .footer__disclaimer {
    margin: 1rem 0 1.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.6;
    opacity: 0.55;
  }

  .footer__disclaimer a {
    color: inherit;
  }

  .footer__form-button {
    width: 100%;
    padding: 1.1rem 1.5rem;
    border: none;
    background-color: #ededea;
    color: #6b6b6b;
    font-family: var(--font-product, 'Ovo', serif);
    font-size: 1.2rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .footer__form-button:hover {
    background-color: var(--color-foreground, #2a2620);
    color: var(--color-background, #ffffff);
  }

  .footer__form-success {
    margin: 0;
    font-size: 1rem;
  }

  /* ---------- Menus ---------- */
  .footer__menus {
    display: grid;
    grid-template-columns: repeat(2, minmax(200px, 240px));
    column-gap: clamp(2rem, 5vw, 4rem);
  }

  .footer__menu-title {
    grid-column: 1 / -1;
    font-family: var(--font-primary--family);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.5;
    margin: 0 0 0.5rem;
  }

  .footer__menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__menu-list li {
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  .footer__menu-list a {
    display: block;
    padding: 1.15rem 0;
    color: #3a3632;
    text-decoration: none;
    font-size: 1.15rem;
    transition: opacity 0.2s ease;
  }

  .footer__menu-list a:hover {
    opacity: 0.55;
  }

  /* Sign-in pill sits under the menu columns. */
  .footer__account {
    grid-column: 1 / -1;
    margin-top: 2rem;
  }

  .footer__signin {
    display: inline-block;
    padding: 0.85rem 2rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 999px;
    font-size: 1rem;
    color: #3a3632;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .footer__signin:hover {
    background-color: var(--color-foreground, #2a2620);
    color: var(--color-background, #ffffff);
    border-color: transparent;
  }

  /* ---------- Bottom ---------- */
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 4rem;
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .footer__bottom a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 989px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 749px) {
    .footer {
      padding-top: 3.5rem;
    }
    .footer__menus {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
    .footer__bottom {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .footer__menus {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join our mailing list"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "textarea",
      "id": "newsletter_disclaimer",
      "label": "Disclaimer",
      "default": "By subscribing, you agree to receive marketing emails. Unsubscribe anytime. See Terms of Use."
    },
    {
      "type": "text",
      "id": "signin_label",
      "label": "Sign in label",
      "default": "Sign In"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Optional. Leave blank for a clean link list."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
