<header class="header full-width">
  <div class="header__bar"></div>

  <div class="header__inner">
    <div class="header__left">
      <button
        type="button"
        class="header__shop"
        data-nav-open
        aria-controls="site-nav"
        aria-expanded="false"
      >
        {{ 'icon-menu.svg' | inline_asset_content }}
        <span>Shop</span>
      </button>
    </div>

    <a href="{{ routes.root_url }}" class="header__logo">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag: widths: '150, 300, 450, 600', alt: shop.name, class: 'header__logo-image'
        }}
      {% else %}
        <span class="header__wordmark">{{ shop.name }}</span>
      {% endif %}
    </a>

    <div class="header__right">
      <a href="{{ routes.search_url }}" class="header__search">
        <span>Search</span>
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      {% if shop.customer_accounts_enabled %}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__account"
          aria-label="{% if customer %}Account{% else %}Log in{% endif %}"
        >
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__cart" aria-label="Cart">
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </div>
</header>

<div class="site-nav" id="site-nav" data-nav aria-hidden="true">
  <div class="site-nav__overlay" data-nav-close></div>

  <aside class="site-nav__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button type="button" class="site-nav__close" data-nav-close aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    {%- if section.settings.menu != blank -%}
      <nav class="site-nav__links" aria-label="Catalog">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="site-nav__link">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- assign feature = section.settings.nav_feature_collection -%}
    {%- if feature != blank and feature.products.size > 0 -%}
      <div class="site-nav__feature">
        <hr class="site-nav__rule">

        {%- if section.settings.nav_feature_logo != blank -%}
          <div class="site-nav__brand">
            {{
              section.settings.nav_feature_logo
              | image_url: width: 600
              | image_tag: widths: '200, 400, 600', alt: feature.title, class: 'site-nav__brand-img'
            }}
          </div>
        {%- endif -%}

        <div class="site-nav__grid">
          {%- for product in feature.products limit: 9 -%}
            <a href="{{ product.url }}" class="nav-card">
              <span class="nav-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="nav-card__title">{{ product.title }}</span>
              <div class="nav-card__media">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 500
                    | image_tag: widths: '250, 500', loading: 'lazy', alt: product.title, class: 'nav-card__img'
                  }}
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </aside>
</div>

{% stylesheet %}
  .header {
    --icon-stroke-width: 1.5;
    font-family: var(--font-body);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .header__bar {
    height: 6px;
    background: var(--color-foreground);
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 4.5rem;
    padding: 0 var(--page-margin);
  }

  .header__left {
    justify-self: start;
  }

  .header__shop {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border: 0;
    padding: 0;
    background: none;
    color: var(--color-foreground);
    text-decoration: none;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
  }

  .header__shop svg {
    width: 1.4rem;
    height: auto;
  }

  .header__logo {
    justify-self: center;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .header__wordmark {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-left: 0.08em;
  }

  .header__logo-image {
    max-height: 2rem;
    width: auto;
  }

  .header__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .header__right .header__account,
  .header__cart {
    position: relative;
    color: var(--color-foreground);
    display: inline-flex;
    align-items: center;
  }

  .header__right svg {
    width: 1.4rem;
    height: auto;
  }

  .header__cart sup {
    position: absolute;
    left: 100%;
    top: -0.25rem;
    font-size: 0.7rem;
  }

  @media (max-width: 749px) {
    .header__shop span,
    .header__search span {
      display: none;
    }
    .header__right {
      gap: 1.1rem;
    }
    .header__wordmark {
      font-size: 1.3rem;
      letter-spacing: 0.1em;
    }
  }

  /* ---- Slide-out catalog navigation ---- */
  .site-nav {
    --nav-ink: #3d434b;
    --nav-accent: #7a4a4a;
    position: fixed;
    inset: 0;
    z-index: 130;
    visibility: hidden;
    pointer-events: none;
  }

  .site-nav.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .site-nav__overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 18, 15, 0.35);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .site-nav.is-open .site-nav__overlay {
    opacity: 1;
  }

  .site-nav__panel {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    height: 100dvh;
    width: min(1040px, 100vw);
    /* Follows the theme background setting, matching the cart drawer and the
       collection filter panel so all slide-out panels stay consistent. */
    background: var(--color-background, #fff);
    display: flex;
    flex-direction: column;
    padding: 2.2rem 3rem 3.5rem;
    overflow-y: auto;
    box-shadow: 8px 0 40px rgba(0, 0, 0, 0.1);
    transform: translateX(-100%);
    transition: transform 0.36s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-nav.is-open .site-nav__panel {
    transform: translateX(0);
  }

  .site-nav__close {
    align-self: flex-start;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: none;
    color: var(--nav-ink);
    cursor: pointer;
    margin-bottom: 2.5rem;
  }

  .site-nav__close svg {
    width: 22px;
    height: 22px;
  }

  .site-nav__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding-left: 0.5rem;
  }

  .site-nav__link {
    font-family: var(--font-product);
    font-size: clamp(2rem, 5vw, 2.9rem);
    line-height: 1.25;
    color: var(--nav-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: var(--nav-accent);
  }

  /* ---- Featured products inside the nav ---- */
  .site-nav__feature {
    margin-top: 3rem;
  }

  .site-nav__rule {
    border: 0;
    border-top: 1px solid rgba(60, 60, 60, 0.18);
    margin: 0 0 2.5rem;
  }

  .site-nav__brand {
    display: flex;
    justify-content: center;
    margin-bottom: 2.8rem;
  }

  .site-nav__brand-img {
    width: auto;
    max-height: 130px;
  }

  .site-nav__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 2rem;
    row-gap: 2.8rem;
  }

  .nav-card {
    display: block;
    text-decoration: none;
    color: var(--nav-ink);
  }

  .nav-card__num {
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--nav-ink);
    opacity: 0.55;
  }

  .nav-card__title {
    display: block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .nav-card__media {
    margin-top: 1rem;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-card__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nav-card:hover .nav-card__title {
    color: var(--nav-accent);
  }

  @media (max-width: 749px) {
    .site-nav__panel {
      padding: 1.6rem 1.6rem 2.4rem;
    }
    .site-nav__close {
      margin-bottom: 1.8rem;
    }
    .site-nav__feature {
      margin-top: 2.2rem;
    }
    .site-nav__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1.2rem;
      row-gap: 2rem;
    }
  }

  @media (max-width: 479px) {
    .site-nav__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Menu featured products"
    },
    {
      "type": "image_picker",
      "id": "nav_feature_logo",
      "label": "Featured logo"
    },
    {
      "type": "collection",
      "id": "nav_feature_collection",
      "label": "Featured collection",
      "info": "Shows up to 9 products from this collection below the menu."
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
