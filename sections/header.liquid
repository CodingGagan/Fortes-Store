<header class="header full-width" data-header>
  <div class="header__bar"></div>

  <div class="header__inner">
    <div class="header__left">
      <button
        type="button"
        class="header__shop"
        data-nav-open
        aria-controls="site-nav"
        aria-expanded="false"
      >
        {{ 'icon-menu.svg' | inline_asset_content }}
        <span>Shop</span>
      </button>
    </div>

    <a href="{{ routes.root_url }}" class="header__logo">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag: widths: '150, 300, 450, 600', alt: shop.name, class: 'header__logo-image'
        }}
      {% else %}
        <span class="header__wordmark">{{ shop.name }}</span>
      {% endif %}
    </a>

    <div class="header__right">
      {%- comment -%}
        Falls back to the search page when JS is unavailable; search.js
        intercepts the click and opens the drawer instead.
      {%- endcomment -%}
      <a
        href="{{ routes.search_url }}"
        class="header__search"
        data-search-open
        aria-controls="site-search"
        aria-expanded="false"
      >
        <span>Search</span>
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      {% if shop.customer_accounts_enabled %}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__account"
          aria-label="{% if customer %}Account{% else %}Log in{% endif %}"
        >
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__cart" aria-label="Cart">
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </div>
</header>

<div class="site-nav" id="site-nav" data-nav aria-hidden="true">
  <div class="site-nav__overlay" data-nav-close></div>

  <aside class="site-nav__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button type="button" class="site-nav__close" data-nav-close aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    {%- if section.settings.menu != blank -%}
      <nav class="site-nav__links" aria-label="Catalog">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="site-nav__link">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- assign feature = section.settings.nav_feature_collection -%}
    {%- if feature != blank and feature.products.size > 0 -%}
      <div class="site-nav__feature">
        <hr class="site-nav__rule">

        {%- if section.settings.nav_feature_logo != blank -%}
          <div class="site-nav__brand">
            {{
              section.settings.nav_feature_logo
              | image_url: width: 600
              | image_tag: widths: '200, 400, 600', alt: feature.title, class: 'site-nav__brand-img'
            }}
          </div>
        {%- endif -%}

        <div class="site-nav__grid">
          {%- for product in feature.products limit: 9 -%}
            <a href="{{ product.url }}" class="nav-card">
              <span class="nav-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="nav-card__title">{{ product.title }}</span>
              <div class="nav-card__media">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 500
                    | image_tag: widths: '250, 500', loading: 'lazy', alt: product.title, class: 'nav-card__img'
                  }}
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </aside>
</div>

{%- comment -%} ===== SEARCH DRAWER (drops down from the header) ===== {%- endcomment -%}
<div class="site-search" id="site-search" data-search aria-hidden="true">
  <div class="site-search__overlay" data-search-close></div>

  <div class="site-search__panel" role="dialog" aria-modal="true" aria-label="Search">
    <form
      class="site-search__form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      data-search-form
    >
      <span class="site-search__icon" aria-hidden="true">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>

      <input
        type="search"
        name="q"
        class="site-search__input"
        placeholder="Search products, collections, pages…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Search"
        data-search-input
      >

      <button type="submit" class="site-search__submit">Search</button>

      <button type="button" class="site-search__close" data-search-close aria-label="Close search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </form>

    <div class="site-search__results" data-search-results aria-live="polite"></div>
  </div>
</div>

{% stylesheet %}
  .header {
    --icon-stroke-width: 1.5;

    /* Themeable surface — the overlay rule below swaps these four values. */
    --header-ink: var(--color-foreground);
    --header-bg: var(--color-background, #fff);
    --header-bar: var(--color-foreground);
    --header-border: rgba(0, 0, 0, 0.08);

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* Below the drawers (120/130) and the collection filter panel (99/100). */
    z-index: 90;
    font-family: var(--font-body);
    color: var(--header-ink);
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-border);
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }

  /**
   * When the first section on the page is a full-bleed hero or banner, the
   * header floats over the artwork with no surface of its own. header.js adds
   * `.is-scrolled` a little way down the page, which drops it back to the solid
   * white bar used everywhere else.
   */
  body:has(> .shopify-section-group-header-group + .shopify-section > :is(.hero, .banner))
    .header:not(.is-scrolled) {
    --header-ink: #fff;
    --header-bg: transparent;
    --header-bar: transparent;
    --header-border: transparent;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  /* text-shadow doesn't reach the inline SVGs, so give them their own. */
  body:has(> .shopify-section-group-header-group + .shopify-section > :is(.hero, .banner))
    .header:not(.is-scrolled) svg {
    filter: drop-shadow(0 1px 8px rgba(0, 0, 0, 0.35));
  }

  .header__bar {
    height: 6px;
    background: var(--header-bar);
    transition: background-color 0.3s ease;
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 4.5rem;
    padding: 0 var(--page-margin);
  }

  .header__left {
    justify-self: start;
  }

  .header__shop {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border: 0;
    padding: 0;
    background: none;
    color: var(--header-ink);
    text-decoration: none;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
  }

  .header__shop svg {
    width: 1.4rem;
    height: auto;
  }

  .header__logo {
    justify-self: center;
    text-decoration: none;
    color: var(--header-ink);
  }

  .header__wordmark {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-left: 0.08em;
  }

  .header__logo-image {
    max-height: 2rem;
    width: auto;
  }

  .header__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--header-ink);
    text-decoration: none;
    font-size: 0.95rem;
    cursor: pointer;
  }

  /* ===== SEARCH DRAWER ===== */
  .site-search {
    position: fixed;
    inset: 0;
    z-index: 120;
    visibility: hidden;
    pointer-events: none;
  }

  .site-search.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .site-search__overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 18, 15, 0.35);
    opacity: 0;
    transition: opacity 0.3s ease;
    cursor: pointer;
  }

  .site-search.is-open .site-search__overlay {
    opacity: 1;
  }

  .site-search__panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: var(--color-background, #fff);
    padding: 1.5rem var(--page-margin) 0;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
    transform: translateY(-100%);
    transition: transform 0.34s cubic-bezier(0.4, 0, 0.2, 1);
    max-height: 88vh;
    max-height: 88dvh;
    display: flex;
    flex-direction: column;
  }

  .site-search.is-open .site-search__panel {
    transform: translateY(0);
  }

  .site-search__form {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    max-width: var(--page-width);
    width: 100%;
    margin: 0 auto;
    border-bottom: 2px solid var(--color-foreground);
    padding-bottom: 0.9rem;
  }

  .site-search__icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--color-foreground);
  }

  .site-search__icon svg {
    width: 1.3rem;
    height: auto;
  }

  .site-search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    color: var(--color-foreground);
    padding: 0.2rem 0;
  }

  .site-search__input::placeholder {
    color: #8c867c;
  }

  /* Hide the browser's native search clear button — we have our own chrome. */
  .site-search__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .site-search__submit {
    flex: 0 0 auto;
    border: 0;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background, #fff);
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.7rem 1.5rem;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .site-search__submit:hover {
    opacity: 0.85;
  }

  .site-search__close {
    flex: 0 0 auto;
    border: 0;
    background: none;
    color: var(--color-foreground);
    display: inline-flex;
    cursor: pointer;
    padding: 0.3rem;
  }

  .site-search__close svg {
    width: 1.3rem;
    height: auto;
  }

  .site-search__results {
    max-width: var(--page-width);
    width: 100%;
    margin: 0 auto;
    overflow-y: auto;
    padding: 1.2rem 0 2rem;
  }

  .site-search.is-loading .site-search__results {
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }

  /* ===== PREDICTIVE RESULTS (markup from sections/predictive-search.liquid) ===== */
  .psearch {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .psearch__label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8c867c;
    margin: 0 0 0.7rem;
  }

  .psearch__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem 1.5rem;
  }

  .psearch__list--plain {
    grid-template-columns: repeat(3, 1fr);
  }

  .psearch__item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.5rem;
    margin: 0 -0.5rem;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .psearch__item:hover {
    background: #f3f2ef;
  }

  .psearch__media {
    flex: 0 0 auto;
    width: 52px;
    aspect-ratio: 3 / 4;
    border-radius: 6px;
    overflow: hidden;
    background: #f1efe9;
  }

  .psearch__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .psearch__info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .psearch__title {
    font-family: var(--font-product);
    font-size: 1rem;
    line-height: 1.25;
  }

  .psearch__price {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .psearch__link {
    color: inherit;
    text-decoration: none;
    font-size: 0.92rem;
    display: inline-block;
    padding: 0.3rem 0;
  }

  .psearch__link:hover {
    text-decoration: underline;
  }

  .psearch__all {
    align-self: flex-start;
    color: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .psearch__empty {
    color: #8c867c;
    font-size: 0.95rem;
    margin: 0;
    padding: 0.5rem 0 1rem;
  }

  @media (max-width: 749px) {
    .site-search__panel {
      padding-top: 1rem;
    }
    .site-search__submit {
      display: none;
    }
    .psearch__list,
    .psearch__list--plain {
      grid-template-columns: 1fr;
    }
  }

  .header__right .header__account,
  .header__cart {
    position: relative;
    color: var(--header-ink);
    display: inline-flex;
    align-items: center;
  }

  .header__right svg {
    width: 1.4rem;
    height: auto;
  }

  .header__cart sup {
    position: absolute;
    left: 100%;
    top: -0.25rem;
    font-size: 0.7rem;
  }

  @media (max-width: 749px) {
    .header__shop span,
    .header__search span {
      display: none;
    }
    .header__right {
      gap: 1.1rem;
    }
    .header__wordmark {
      font-size: 1.3rem;
      letter-spacing: 0.1em;
    }
  }

  /* ---- Slide-out catalog navigation ---- */
  .site-nav {
    --nav-ink: #3d434b;
    --nav-accent: #7a4a4a;
    position: fixed;
    inset: 0;
    z-index: 130;
    visibility: hidden;
    pointer-events: none;
  }

  .site-nav.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .site-nav__overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 18, 15, 0.35);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .site-nav.is-open .site-nav__overlay {
    opacity: 1;
  }

  .site-nav__panel {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    height: 100dvh;
    width: min(1040px, 100vw);
    /* Follows the theme background setting, matching the cart drawer and the
       collection filter panel so all slide-out panels stay consistent. */
    background: var(--color-background, #fff);
    display: flex;
    flex-direction: column;
    padding: 2.2rem 3rem 3.5rem;
    overflow-y: auto;
    box-shadow: 8px 0 40px rgba(0, 0, 0, 0.1);
    transform: translateX(-100%);
    transition: transform 0.36s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-nav.is-open .site-nav__panel {
    transform: translateX(0);
  }

  .site-nav__close {
    align-self: flex-start;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: none;
    color: var(--nav-ink);
    cursor: pointer;
    margin-bottom: 2.5rem;
  }

  .site-nav__close svg {
    width: 22px;
    height: 22px;
  }

  .site-nav__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding-left: 0.5rem;
  }

  .site-nav__link {
    font-family: var(--font-product);
    font-size: clamp(2rem, 5vw, 2.9rem);
    line-height: 1.25;
    color: var(--nav-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: var(--nav-accent);
  }

  /* ---- Featured products inside the nav ---- */
  .site-nav__feature {
    margin-top: 3rem;
  }

  .site-nav__rule {
    border: 0;
    border-top: 1px solid rgba(60, 60, 60, 0.18);
    margin: 0 0 2.5rem;
  }

  .site-nav__brand {
    display: flex;
    justify-content: center;
    margin-bottom: 2.8rem;
  }

  .site-nav__brand-img {
    width: auto;
    max-height: 130px;
  }

  .site-nav__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 2rem;
    row-gap: 2.8rem;
  }

  .nav-card {
    display: block;
    text-decoration: none;
    color: var(--nav-ink);
  }

  .nav-card__num {
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--nav-ink);
    opacity: 0.55;
  }

  .nav-card__title {
    display: block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .nav-card__media {
    margin-top: 1rem;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-card__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nav-card:hover .nav-card__title {
    color: var(--nav-accent);
  }

  @media (max-width: 749px) {
    .site-nav__panel {
      padding: 1.6rem 1.6rem 2.4rem;
    }
    .site-nav__close {
      margin-bottom: 1.8rem;
    }
    .site-nav__feature {
      margin-top: 2.2rem;
    }
    .site-nav__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1.2rem;
      row-gap: 2rem;
    }
  }

  @media (max-width: 479px) {
    .site-nav__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Menu featured products"
    },
    {
      "type": "image_picker",
      "id": "nav_feature_logo",
      "label": "Featured logo"
    },
    {
      "type": "collection",
      "id": "nav_feature_collection",
      "label": "Featured collection",
      "info": "Shows up to 9 products from this collection below the menu."
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
