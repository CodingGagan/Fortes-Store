<header class="header full-width">
  <div class="header__bar"></div>

  <div class="header__inner">
    <div class="header__left">
      <a href="{{ routes.all_products_collection_url }}" class="header__shop">
        {{ 'icon-menu.svg' | inline_asset_content }}
        <span>Shop</span>
      </a>
    </div>

    <a href="{{ routes.root_url }}" class="header__logo">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag: widths: '150, 300, 450, 600', alt: shop.name, class: 'header__logo-image'
        }}
      {% else %}
        <span class="header__wordmark">{{ shop.name }}</span>
      {% endif %}
    </a>

    <div class="header__right">
      <a href="{{ routes.search_url }}" class="header__search">
        <span>Search</span>
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__cart" aria-label="Cart">
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    --icon-stroke-width: 1.5;
    font-family: var(--font-body);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .header__bar {
    height: 6px;
    background: var(--color-foreground);
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 4.5rem;
    padding: 0 var(--page-margin);
  }

  .header__left {
    justify-self: start;
  }

  .header__shop {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .header__shop svg {
    width: 1.4rem;
    height: auto;
  }

  .header__logo {
    justify-self: center;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .header__wordmark {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-left: 0.08em;
  }

  .header__logo-image {
    max-height: 2rem;
    width: auto;
  }

  .header__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .header__right shopify-account,
  .header__cart {
    position: relative;
    color: var(--color-foreground);
    display: inline-flex;
    align-items: center;
  }

  .header__right svg {
    width: 1.4rem;
    height: auto;
  }

  .header__cart sup {
    position: absolute;
    left: 100%;
    top: -0.25rem;
    font-size: 0.7rem;
  }

  @media (max-width: 749px) {
    .header__shop span,
    .header__search span {
      display: none;
    }
    .header__right {
      gap: 1.1rem;
    }
    .header__wordmark {
      font-size: 1.3rem;
      letter-spacing: 0.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
