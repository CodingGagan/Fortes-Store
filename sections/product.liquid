{% comment %}
  Product details (PDP).

  Mirrors the Fortes product mockup:
    · breadcrumb
    · image gallery (thumbnail rail + sticky main, hover zoom)
    · vendor, title, rating, price + compare-at + discount badge
    · variant pickers — colour swatches + size/other buttons wired to real
      product.options_with_values / product.variants
    · quantity stepper + Add to cart (native form) + dynamic Buy it now
    · trust row + collapsible rows (blocks) + related products

  Variant selection, gallery swapping and the quantity stepper use a small
  section-scoped script (a PDP genuinely needs it); everything degrades to the
  first available variant when JS is off.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign color_name = section.settings.color_option_name | downcase
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0

  # Identify the colour option so the gallery can be filtered per colour.
  assign color_option = null
  for option in product.options_with_values
    assign odc = option.name | downcase
    if odc == color_name or odc contains 'color' or odc contains 'colour'
      assign color_option = option
      break
    endif
  endfor
  if color_option
    assign color_index = color_option.position | minus: 1
    assign current_color = current_variant.options[color_index] | downcase
  endif
-%}

<div class="pdp-page full-width">
<div class="pdp" id="pdp-{{ section.id }}">
  {%- comment -%} ===== BREADCRUMB ===== {%- endcomment -%}
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <span aria-hidden="true">/</span>
    {%- endif -%}
    <span class="crumb__current">{{ product.title }}</span>
  </nav>

  <div class="pdp__grid">
    {%- comment -%} ===== GALLERY ===== {%- endcomment -%}
    <div class="gallery{% if section.settings.sticky_gallery %} gallery--sticky{% endif %}">
      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs" role="list">
          {%- for media in product.media -%}
            {%- liquid
              # Tag each media with the colour it belongs to, so the gallery can
              # be filtered on colour selection. Prefer Shopify's variant→image
              # association; fall back to matching the colour name in the alt text.
              assign media_color = ''
              if color_option
                for v in product.variants
                  if v.featured_media.id == media.id
                    assign media_color = v.options[color_index]
                    break
                  endif
                endfor
                if media_color == blank
                  assign alt_dc = media.alt | downcase
                  for cval in color_option.values
                    assign cval_dc = cval | downcase
                    if alt_dc contains cval_dc
                      assign media_color = cval
                      break
                    endif
                  endfor
                endif
              endif
            -%}
            {%- capture thumb_srcset -%}
              {{ media.preview_image | image_url: width: 600 }} 600w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1200 }} 1200w, {{ media.preview_image | image_url: width: 1400 }} 1400w
            {%- endcapture -%}
            <button
              type="button"
              class="gallery__thumb{% if forloop.first %} is-on{% endif %}"
              data-media-id="{{ media.id }}"
              data-src="{{ media.preview_image | image_url: width: 1400 }}"
              data-srcset="{{ thumb_srcset | strip | escape }}"
              {% if media_color != blank %}data-color="{{ media_color | downcase | escape }}"{% endif %}
              aria-label="View image {{ forloop.index }}"
            >
              {{
                media.preview_image
                | image_url: width: 160
                | image_tag: widths: '80, 160', loading: 'lazy', alt: media.preview_image.alt | default: product.title
              }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="gallery__main" data-current-media="{{ product.featured_media.id }}">
        {%- if on_sale -%}
          {%- assign save_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
          <span class="gallery__tag" data-save-tag>Save {{ save_pct }}%</span>
        {%- endif -%}
        {%- assign main_img_id = 'MainImg-' | append: section.id -%}
        {%- if product.featured_media -%}
          {{
            product.featured_media
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1000, 1400',
              sizes: '(max-width: 900px) 100vw, 55vw',
              id: main_img_id,
              class: 'gallery__img',
              alt: product.featured_media.alt | default: product.title
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'gallery__img gallery__img--placeholder' }}
        {%- endif -%}

        {%- comment -%}
          Shown only while a swap is genuinely waiting on the network — a
          cached image is applied synchronously and never reaches this.
        {%- endcomment -%}
        <span class="gallery__loading" data-gallery-loading hidden aria-hidden="true"></span>
      </div>
    </div>

    {%- comment -%} ===== INFO ===== {%- endcomment -%}
    <div class="info">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="ptitle">{{ product.title }}</h1>

      {%- if rating != blank or section.settings.show_sku -%}
        <div class="prow">
          {%- if rating != blank -%}
            {%- assign rating_round = rating | round -%}
            <span class="stars" aria-label="Rated {{ rating }} out of 5">
              {%- for i in (1..5) -%}{% if i <= rating_round %}★{% else %}☆{% endif %}{%- endfor -%}
            </span>
            <a href="#reviews">{{ rating_count }} reviews</a>
          {%- endif -%}
          {%- if section.settings.show_sku -%}
            <span class="prow__sku">· SKU: <span data-sku>{{ current_variant.sku }}</span></span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="price" data-price-block>
        <span class="price__now" data-price>{{ current_variant.price | money }}</span>
        <span class="price__was was" data-compare {% unless on_sale %}hidden{% endunless %}>
          {{- current_variant.compare_at_price | money -}}
        </span>
        <span class="price__off off" data-discount {% unless on_sale %}hidden{% endunless %}>
          {%- if on_sale -%}
            −{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}%
          {%- endif -%}
        </span>
      </div>
      <p class="tax">Tax included. Shipping calculated at checkout.</p>

      {%- form 'product', product, class: 'product-form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- comment -%} ===== VARIANT PICKERS ===== {%- endcomment -%}

        {%- comment -%}
          Colours are sold as separate products here, so the colour row comes
          from the product group rather than from variants. Captured first so
          the loop below knows whether a single-value colour picker would be a
          duplicate.
        {%- endcomment -%}
        {%- capture color_group_html -%}
          {%- if section.settings.show_color_group -%}
            {%- render 'color-group-swatches',
              product: product,
              group_prefix: section.settings.color_group_prefix,
              swatch_map: section.settings.color_swatch_map
            -%}
          {%- endif -%}
        {%- endcapture -%}
        {%- assign has_color_group = false -%}
        {%- if color_group_html contains 'data-color-group' -%}
          {%- assign has_color_group = true -%}
        {%- endif -%}
        {{ color_group_html }}

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign opt_name_dc = option.name | downcase -%}
            {%- assign is_color = false -%}
            {%- if opt_name_dc == color_name or opt_name_dc contains 'color' or opt_name_dc contains 'colour' -%}
              {%- assign is_color = true -%}
            {%- endif -%}

            {%- comment -%}
              A one-colour product inside a group already has its colour shown
              by the group row above, so that picker is hidden rather than
              dropped — the script still reads its checked input to resolve the
              variant.
            {%- endcomment -%}
            {%- assign hide_option = false -%}
            {%- if is_color and has_color_group and option.values.size == 1 -%}
              {%- assign hide_option = true -%}
            {%- endif -%}

            <div
              class="opt"
              data-option-index="{{ option.position }}"
              {% if is_color %}data-color-option{% endif %}
              {% if hide_option %}hidden{% endif %}
            >
              <div class="opt__label">
                {{ option.name }}
                {%- if is_color %}: <span data-option-selected="{{ option.position }}">{{ option.selected_value }}</span>{% endif -%}
                {%- if forloop.first == false and section.settings.size_guide_url != blank and is_color == false %}
                  <a class="size-guide" href="{{ section.settings.size_guide_url }}">Size guide</a>
                {%- endif -%}
              </div>

              {%- if is_color -%}
                <div class="swatches">
                  {%- for value in option.values -%}
                    <label
                      class="swatch{% if value.selected %} is-on{% endif %}"
                      title="{{ value | escape }}"
                      style="{% render 'swatch-style', swatch_value: value, swatch_map: section.settings.color_swatch_map %}"
                    >
                      <input
                        type="radio"
                        name="option-{{ option.position }}"
                        value="{{ value | escape }}"
                        data-option-position="{{ option.position }}"
                        {% if value.selected %}checked{% endif %}
                        hidden
                      >
                      <span class="visually-hidden">{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <div class="sizes">
                  {%- for value in option.values -%}
                    <label class="size{% if value.selected %} is-on{% endif %}">
                      <input
                        type="radio"
                        name="option-{{ option.position }}"
                        value="{{ value | escape }}"
                        data-option-position="{{ option.position }}"
                        {% if value.selected %}checked{% endif %}
                        hidden
                      >
                      {{ value }}
                    </label>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}

          {%- comment -%} No-JS fallback: real variant selector. {%- endcomment -%}
          <noscript>
            <div class="opt">
              <div class="opt__label">Variant</div>
              <select name="id" class="opt__select">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (sold out){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          </noscript>
        {%- endunless -%}

        {%- comment -%} ===== BUY BAR ===== {%- endcomment -%}
        <div class="buybar">
          <div class="qty">
            <button type="button" class="qty__btn" data-qty-minus aria-label="Decrease quantity">−</button>
            <input
              class="qty__input"
              type="number"
              name="quantity"
              value="1"
              min="1"
              inputmode="numeric"
              aria-label="Quantity"
              data-qty-input
            >
            <button type="button" class="qty__btn" data-qty-plus aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="atc" data-atc {% unless current_variant.available %}disabled{% endunless %}>
            <span data-atc-text>
              {%- if current_variant.available -%}
                Add to cart · <span data-atc-price>{{ current_variant.price | money }}</span>
              {%- else -%}
                Sold out
              {%- endif -%}
            </span>
          </button>
        </div>

        {{ form | payment_button }}

        {%- if section.settings.pay_later_text != blank -%}
          <p class="paylater">{{ section.settings.pay_later_text }}</p>
        {%- endif -%}
      {%- endform -%}

      {%- comment -%} ===== TRUST ROW ===== {%- endcomment -%}
      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
        <div class="trust">
          {%- if section.settings.trust_1 != blank -%}
            <div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h13v10H3z"/><path d="M16 10h4l1 3v4h-5z"/><circle cx="7" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg>
              {{ section.settings.trust_1 }}
            </div>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v18"/><path d="M5 8l7-5 7 5"/><path d="M5 8v8l7 5 7-5V8"/></svg>
              {{ section.settings.trust_2 }}
            </div>
          {%- endif -%}
          {%- if section.settings.trust_3 != blank -%}
            <div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
              {{ section.settings.trust_3 }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ===== COLLAPSIBLE ROWS (blocks) ===== {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <details class="acc" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading | default: 'Description' }}</summary>
                <div class="acc__body rte">{{ product.description }}</div>
              </details>
            {%- endif -%}
          {%- when 'collapsible' -%}
            {%- if block.settings.content != blank -%}
              <details class="acc" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading }}</summary>
                <div class="acc__body rte">{{ block.settings.content }}</div>
              </details>
            {%- endif -%}
          {%- when 'combo' -%}
            {%- assign combo_items = product.metafields.custom.combo_products.value -%}
            {%- if combo_items and combo_items.size > 0 -%}
              <div class="combo" {{ block.shopify_attributes }}>
                <div class="combo__head">
                  <span class="combo__title">{{ block.settings.heading }}</span>
                  <span class="combo__count">{{ combo_items.size }} items</span>
                </div>
                <ul class="combo__list" role="list">
                  {%- for item in combo_items -%}
                    <li class="combo__item">
                      <a href="{{ item.url }}" class="combo__link">
                        <span class="combo__media">
                          {%- if item.featured_media -%}
                            {{ item.featured_media | image_url: width: 160 | image_tag: widths: '80, 160', loading: 'lazy', alt: item.title, class: 'combo__img' }}
                          {%- endif -%}
                        </span>
                        <span class="combo__info">
                          <span class="combo__name">{{ item.title }}</span>
                          {%- if block.settings.show_item_price -%}
                            <span class="combo__price">{{ item.price | money }}</span>
                          {%- endif -%}
                        </span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
                {%- if block.settings.show_savings -%}
                  {%- assign combo_sum = 0 -%}
                  {%- for item in combo_items -%}
                    {%- assign combo_sum = combo_sum | plus: item.price -%}
                  {%- endfor -%}
                  {%- if combo_sum > current_variant.price -%}
                    <p class="combo__savings">
                      Buy together for <strong>{{ current_variant.price | money }}</strong>
                      <span class="combo__was">{{ combo_sum | money }}</span>
                      <span class="combo__save">Save {{ combo_sum | minus: current_variant.price | money }}</span>
                    </p>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} ===== RELATED PRODUCTS ===== {%- endcomment -%}
{%- if section.settings.show_related -%}
  {%- assign related_collection = product.collections.first -%}
  {%- if related_collection and related_collection.products.size > 1 -%}
    <section class="related" id="reviews">
      <h2>{{ section.settings.related_heading }}</h2>
      <div class="rgrid">
        {%- assign shown = 0 -%}
        {%- for rp in related_collection.products -%}
          {%- if rp.id != product.id and shown < 4 -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign rp_on_sale = false -%}
            {%- if rp.compare_at_price > rp.price -%}
              {%- assign rp_on_sale = true -%}
            {%- endif -%}
            <a class="rcard" href="{{ rp.url }}">
              <div class="rcard__media">
                {%- if rp.featured_media -%}
                  {{
                    rp.featured_media
                    | image_url: width: 600
                    | image_tag: widths: '300, 450, 600', loading: 'lazy', class: 'rcard__img', alt: rp.title
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'rcard__img' }}
                {%- endif -%}
              </div>
              <div class="rcard__info">
                <h3 class="rcard__title">{{ rp.title }}</h3>
                <p class="rcard__price">
                  {%- if rp_on_sale -%}
                    {{ rp.price | money }}
                    <span class="was">{{ rp.compare_at_price | money }}</span>
                  {%- elsif rp.price_varies -%}
                    From {{ rp.price_min | money }}
                  {%- else -%}
                    {{ rp.price | money }}
                  {%- endif -%}
                </p>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

<script type="application/json" data-variants-json id="VariantsJson-{{ section.id }}">
  {{ product.variants | json }}
</script>
<script type="application/json" data-variant-meta id="VariantMeta-{{ section.id }}">
  {
    {%- for v in product.variants -%}
      "{{ v.id }}": {
        "priceMoney": {{ v.price | money | json }},
        "compareMoney": {{ v.compare_at_price | money | json }},
        "price": {{ v.price | json }},
        "compare": {{ v.compare_at_price | default: 0 | json }},
        "sku": {{ v.sku | json }},
        "mediaId": {{ v.featured_media.id | default: 0 | json }},
        "mediaSrc": {{ v.featured_media.preview_image | image_url: width: 1400 | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

<script>
  (function () {
    var root = document.getElementById('pdp-{{ section.id }}');
    if (!root) return;

    var mainImg = document.getElementById('MainImg-{{ section.id }}');

    var variants = [];
    var meta = {};
    // Parse each block on its own so a fault in the (hand-built) meta block
    // can't also wipe out the variants array, and vice-versa.
    try {
      var variantsEl = document.getElementById('VariantsJson-{{ section.id }}');
      if (variantsEl) variants = JSON.parse(variantsEl.textContent) || [];
    } catch (err) { /* selection + quantity still work below */ }
    try {
      var metaEl = document.getElementById('VariantMeta-{{ section.id }}');
      if (metaEl) meta = JSON.parse(metaEl.textContent) || {};
    } catch (err) { /* meta only feeds the image swap now; prices come from variants */ }

    // Client-side money formatting from the shop format, so price/compare/ATC
    // are derived from the always-valid variants array (price in cents) and
    // never depend on the fragile meta block.
    var moneyFormat = {{ shop.money_format | json }};
    function formatMoney(cents, format) {
      format = format || '${{amount}}';
      if (cents == null || isNaN(cents)) return '';
      var placeholder = /\{\{\s*(\w+)\s*\}\}/;
      function withDelimiters(number, precision, thousands, decimal) {
        precision = precision == null ? 2 : precision;
        thousands = thousands == null ? ',' : thousands;
        decimal = decimal == null ? '.' : decimal;
        number = (number / 100).toFixed(precision);
        var parts = number.split('.');
        var dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        var frac = parts[1] ? decimal + parts[1] : '';
        return dollars + frac;
      }
      var value = '';
      var match = format.match(placeholder);
      switch (match ? match[1] : 'amount') {
        case 'amount': value = withDelimiters(cents, 2); break;
        case 'amount_no_decimals': value = withDelimiters(cents, 0); break;
        case 'amount_with_comma_separator': value = withDelimiters(cents, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': value = withDelimiters(cents, 0, '.', ','); break;
        case 'amount_with_space_separator': value = withDelimiters(cents, 2, ' ', '.'); break;
        case 'amount_with_apostrophe_separator': value = withDelimiters(cents, 2, "'", '.'); break;
        default: value = withDelimiters(cents, 2);
      }
      return format.replace(placeholder, value);
    }

    var idInput = root.querySelector('[data-variant-id]');
    var priceEl = root.querySelector('[data-price]');
    var compareEl = root.querySelector('[data-compare]');
    var discountEl = root.querySelector('[data-discount]');
    var atc = root.querySelector('[data-atc]');
    var atcText = root.querySelector('[data-atc-text]');
    var skuEl = root.querySelector('[data-sku]');
    var saveTag = root.querySelector('[data-save-tag]');
    var optionInputs = root.querySelectorAll('input[data-option-position]');

    function selectedOptions() {
      var opts = [];
      root.querySelectorAll('.opt[data-option-index]').forEach(function (group) {
        var checked = group.querySelector('input[data-option-position]:checked');
        opts[+group.dataset.optionIndex - 1] = checked ? checked.value : null;
      });
      return opts;
    }

    function findVariant(opts) {
      return variants.find(function (v) {
        return v.options.every(function (o, i) { return o === opts[i]; });
      });
    }

    // Disable option values whose combination has no matching (existing) variant.
    function refreshAvailability() {
      if (!variants.length) return;
      var current = selectedOptions();
      root.querySelectorAll('.opt[data-option-index]').forEach(function (group) {
        var pos = +group.dataset.optionIndex - 1;
        group.querySelectorAll('input[data-option-position]').forEach(function (input) {
          var trial = current.slice();
          trial[pos] = input.value;
          var match = variants.find(function (v) {
            return v.options.every(function (o, i) {
              return i === pos ? o === input.value : (trial[i] == null || o === trial[i]);
            });
          });
          var label = input.closest('.swatch, .size');
          if (!label) return;
          label.classList.toggle('is-out', !!match && !match.available);
          label.classList.toggle('is-none', !match);
        });
      });
    }

    function update() {
      var variant = findVariant(selectedOptions());

      // Reflect the selected value name (colour label).
      root.querySelectorAll('[data-option-selected]').forEach(function (span) {
        var pos = +span.dataset.optionSelected;
        var checked = root.querySelector('.opt[data-option-index="' + pos + '"] input:checked');
        if (checked) span.textContent = checked.value;
      });

      refreshAvailability();

      // No parsed variant data: keep the server-rendered price / button.
      if (!variants.length) return;

      if (!variant) {
        atc.disabled = true;
        atcText.textContent = 'Unavailable';
        return;
      }

      var m = meta[variant.id] || {};
      idInput.value = variant.id;

      // Prices/sku come straight from the variant (always-valid Shopify JSON),
      // formatted client-side — never from the fragile meta block.
      var price = variant.price;
      var compare = variant.compare_at_price;
      var priceMoney = formatMoney(price, moneyFormat);

      if (priceEl) priceEl.textContent = priceMoney;
      if (skuEl) skuEl.textContent = variant.sku || '';

      var hasCompare = compare && compare > price;
      if (compareEl) { compareEl.hidden = !hasCompare; compareEl.textContent = hasCompare ? formatMoney(compare, moneyFormat) : ''; }
      if (discountEl) {
        discountEl.hidden = !hasCompare;
        if (hasCompare) discountEl.textContent = '−' + Math.round((compare - price) * 100 / compare) + '%';
      }
      if (saveTag) {
        saveTag.hidden = !hasCompare;
        if (hasCompare) saveTag.textContent = 'Save ' + Math.round((compare - price) * 100 / compare) + '%';
      }

      if (variant.available) {
        atc.disabled = false;
        atcText.innerHTML = 'Add to cart · <span data-atc-price>' + priceMoney + '</span>';
      } else {
        atc.disabled = true;
        atcText.textContent = 'Sold out';
      }

      // Gallery follows the colour. When the product has a colour option we
      // filter the thumbnails to that colour and show its first image; the
      // filter only re-runs when the colour actually changes, so picking a
      // size never disturbs the image the shopper is looking at. Products
      // without a colour option keep the simple per-variant image swap.
      if (colorOptionEl) {
        var color = selectedColor();
        if (color !== lastColor) {
          lastColor = color;
          filterGalleryByColor(color);
        }
      } else if (mainImg) {
        if (m.mediaSrc) {
          setMainImage(m.mediaSrc, m.mediaId);
        } else if (variant.featured_image && variant.featured_image.src) {
          setMainImage(variant.featured_image.src, variant.featured_image.id);
        }
      }
    }

    // ===== Main image swapping =====
    // The gallery used to assign mainImg.src straight from the click, which
    // left the old photo on screen — with no feedback — for as long as the new
    // one took to arrive. Instead every candidate is pulled into the browser
    // cache ahead of time, and a swap only paints once the new image has
    // decoded. Cached images (the normal case after warm-up) swap in the same
    // frame as the click; only a genuine network wait shows the spinner.
    var mainSizes = mainImg ? mainImg.getAttribute('sizes') : null;
    var mainWrap = root.querySelector('.gallery__main');
    var loadingEl = root.querySelector('[data-gallery-loading]');
    var swapToken = 0;
    var warmed = Object.create(null);

    function warmImage(src, srcset) {
      if (!src) return null;
      if (warmed[src]) return warmed[src];
      var img = new Image();
      if (mainSizes) img.sizes = mainSizes;
      if (srcset) img.srcset = srcset;
      img.src = src;
      // Held in the map so the fetch isn't cut short by garbage collection.
      warmed[src] = img;
      return img;
    }

    function setLoading(on) {
      if (loadingEl) loadingEl.hidden = !on;
    }

    function showMainImage(src, srcset) {
      if (!mainImg || !src) return;
      var token = ++swapToken;
      var pre = warmImage(src, srcset);

      function apply() {
        // A newer click already won the race — leave its image alone.
        if (token !== swapToken) return;
        if (srcset) {
          mainImg.srcset = srcset;
        } else {
          mainImg.removeAttribute('srcset');
        }
        mainImg.src = src;
        setLoading(false);
      }

      if (pre.complete && pre.naturalWidth) {
        apply();
        return;
      }
      setLoading(true);
      if (pre.decode) {
        pre.decode().then(apply, apply);
      } else {
        pre.addEventListener('load', apply);
        pre.addEventListener('error', apply);
      }
    }

    // True when the requested media is already the one on screen — swapping it
    // would only throw away the server-rendered responsive image and refetch.
    function isCurrentMedia(mediaId) {
      return !!mediaId && !!mainWrap && mainWrap.dataset.currentMedia === String(mediaId);
    }

    function markCurrentMedia(mediaId) {
      if (mainWrap && mediaId) mainWrap.dataset.currentMedia = String(mediaId);
    }

    function setMainImage(src, mediaId) {
      if (!mainImg || isCurrentMedia(mediaId)) return;
      showMainImage(src, null);
      markCurrentMedia(mediaId);
      root.querySelectorAll('.gallery__thumb').forEach(function (t) {
        t.classList.toggle('is-on', mediaId && +t.dataset.mediaId === +mediaId);
      });
    }

    // ===== Colour-driven gallery =====
    var colorOptionEl = root.querySelector('[data-color-option]');
    var lastColor = null;

    function selectedColor() {
      if (!colorOptionEl) return null;
      var checked = colorOptionEl.querySelector('input:checked');
      return checked ? checked.value.toLowerCase() : null;
    }

    // Make a thumbnail the active/main image.
    function activateThumb(thumb) {
      if (!thumb) return;
      root.querySelectorAll('.gallery__thumb').forEach(function (t) { t.classList.remove('is-on'); });
      thumb.classList.add('is-on');
      if (isCurrentMedia(thumb.dataset.mediaId)) return;
      showMainImage(thumb.dataset.src, thumb.dataset.srcset);
      markCurrentMedia(thumb.dataset.mediaId);
    }

    // First thumbnail tagged with a colour — what a swatch click lands on.
    function firstThumbForColor(color) {
      var thumbs = root.querySelectorAll('.gallery__thumb');
      for (var i = 0; i < thumbs.length; i++) {
        if ((thumbs[i].dataset.color || '') === color) return thumbs[i];
      }
      return null;
    }

    // Show only the thumbnails belonging to the given colour (plus any untagged
    // shared shots) and promote that colour's first image to the main view.
    function filterGalleryByColor(color) {
      var thumbs = root.querySelectorAll('.gallery__thumb');
      if (!thumbs.length) return;

      var hasMatch = false;
      thumbs.forEach(function (t) { if ((t.dataset.color || '') === color) hasMatch = true; });

      var firstColorThumb = null, firstVisible = null;
      thumbs.forEach(function (t) {
        var c = t.dataset.color || '';
        // Only hide thumbs tagged to a *different* colour; keep untagged ones.
        var hide = hasMatch && c && c !== color;
        t.hidden = hide;
        if (!hide) {
          if (!firstVisible) firstVisible = t;
          if (c === color && !firstColorThumb) firstColorThumb = t;
        }
      });

      var target = firstColorThumb || (hasMatch ? firstVisible : null);
      if (target) activateThumb(target);
    }

    optionInputs.forEach(function (input) {
      input.addEventListener('change', function () {
        // Move the visual "is-on" state within the group.
        var group = input.closest('.opt');
        group.querySelectorAll('.swatch, .size').forEach(function (l) { l.classList.remove('is-on'); });
        var label = input.closest('.swatch, .size');
        if (label) label.classList.add('is-on');
        update();
      });
    });

    // Thumbnail rail.
    root.querySelectorAll('.gallery__thumb').forEach(function (thumb) {
      thumb.addEventListener('click', function () { activateThumb(thumb); });
      // Pointing at a thumb is a strong signal it's about to be clicked.
      thumb.addEventListener('pointerenter', function () {
        warmImage(thumb.dataset.src, thumb.dataset.srcset);
      });
    });

    // Hovering a swatch starts its image before the click lands, so by the time
    // the shopper commits the swap is usually already in cache.
    if (colorOptionEl) {
      colorOptionEl.querySelectorAll('.swatch').forEach(function (label) {
        label.addEventListener('pointerenter', function () {
          var input = label.querySelector('input');
          if (!input) return;
          var thumb = firstThumbForColor(input.value.toLowerCase());
          if (thumb) warmImage(thumb.dataset.src, thumb.dataset.srcset);
        });
      });
    }

    // Background warm-up once the page is idle: the opening shot of every
    // colour first (that's what swatch clicks hit), then the remaining images.
    // Capped so a product with a long gallery doesn't pull the whole set.
    function warmGallery() {
      var thumbs = Array.prototype.slice.call(root.querySelectorAll('.gallery__thumb'));
      var seen = Object.create(null);
      var lead = [];
      var rest = [];
      thumbs.forEach(function (t) {
        var c = t.dataset.color || '';
        if (c && !seen[c]) {
          seen[c] = true;
          lead.push(t);
        } else {
          rest.push(t);
        }
      });
      lead.concat(rest).slice(0, 12).forEach(function (t) {
        warmImage(t.dataset.src, t.dataset.srcset);
      });
    }

    if (window.requestIdleCallback) {
      requestIdleCallback(warmGallery, { timeout: 3000 });
    } else {
      setTimeout(warmGallery, 600);
    }

    // Filter to the initially-selected colour on load.
    lastColor = selectedColor();
    filterGalleryByColor(lastColor);

    // Quantity stepper.
    var qtyInput = root.querySelector('[data-qty-input]');
    var minus = root.querySelector('[data-qty-minus]');
    var plus = root.querySelector('[data-qty-plus]');
    if (minus) minus.addEventListener('click', function () { qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1); });
    if (plus) plus.addEventListener('click', function () { qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1; });

    // Add-to-cart submission + drawer are handled globally by assets/cart.js,
    // which intercepts this form and opens the slide-out cart. This section only
    // owns variant selection, gallery and quantity.

    refreshAvailability();
  })();
</script>
</div>{%- comment -%} /.pdp-page {%- endcomment -%}

{% stylesheet %}
  /* Design tokens mirroring the Fortes mockup, scoped to this page. */
  .pdp-page {
    --col-paper: #f3f1ec;
    --col-media: #e9e6df;
    --col-ink: #1c1c1c;
    --col-body: #4a463f;
    --col-muted: #8c867c;
    --col-line: #e4e1d9;
    --col-accent: #5b6b96;
    background: var(--col-paper);
    color: var(--col-ink);
  }

  .pdp {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 1.2rem var(--page-margin) 4rem;
    color: var(--col-ink);
  }

  /* ===== BREADCRUMB ===== */
  .crumb {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--col-muted, #8c867c);
    padding: 0.4rem 0 1.5rem;
  }

  .crumb a:hover {
    color: var(--col-ink, #1c1c1c);
  }

  /* ===== GRID ===== */
  .pdp__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  /* ===== GALLERY ===== */
  .gallery {
    display: grid;
    grid-template-columns: 78px 1fr;
    gap: 1rem;
  }

  .gallery--sticky {
    position: sticky;
    top: calc(var(--header-height) + 1rem);
  }

  .gallery__thumbs {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .gallery__thumb {
    padding: 0;
    border: 1px solid var(--col-line, #e4e1d9);
    border-radius: 8px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    aspect-ratio: 3 / 4;
  }

  .gallery__thumb.is-on {
    border-color: var(--col-ink, #1c1c1c);
  }

  .gallery__thumb[hidden] {
    display: none;
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__main {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--col-media, #e9e6df);
    aspect-ratio: 3 / 4;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery__main:hover .gallery__img {
    transform: scale(1.08);
  }

  /**
   * Swap spinner. The fade-in is delayed so a swap that resolves quickly
   * finishes before the spinner is ever visible — no flicker on fast swaps,
   * clear feedback on slow ones.
   */
  .gallery__loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    background: rgba(233, 230, 223, 0.55);
    pointer-events: none;
    animation: gallery-loading-in 0.15s ease 0.15s both;
  }

  .gallery__loading[hidden] {
    display: none;
  }

  .gallery__loading::after {
    content: '';
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid rgba(0, 0, 0, 0.18);
    border-top-color: var(--col-ink, #1c1c1c);
    animation: gallery-loading-spin 0.7s linear infinite;
  }

  @keyframes gallery-loading-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes gallery-loading-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__loading::after {
      animation-duration: 2.4s;
    }
  }

  .gallery__tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #d8b13a;
    color: #1c1c1c;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
  }

  /* ===== INFO ===== */
  .vendor {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--col-accent, #5b6b96);
    font-weight: 600;
    margin: 0 0 0.6rem;
  }

  .ptitle {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.05;
    margin: 0 0 0.8rem;
  }

  .prow {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }

  .stars {
    color: #d8b13a;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .prow a {
    font-size: 0.82rem;
    color: var(--col-muted, #8c867c);
    text-decoration: underline;
  }

  .prow__sku {
    color: var(--col-muted, #8c867c);
    font-size: 0.82rem;
  }

  .price {
    font-size: 1.6rem;
    font-weight: 600;
  }

  .price .was {
    color: var(--col-muted, #8c867c);
    font-weight: 400;
    text-decoration: line-through;
    margin-left: 0.6rem;
    font-size: 1.1rem;
  }

  .price .off {
    margin-left: 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    background: #6e2b2b;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    vertical-align: middle;
  }

  .tax {
    font-size: 0.78rem;
    color: var(--col-muted, #8c867c);
    margin: 0.3rem 0 1.6rem;
  }

  /* ===== OPTIONS ===== */
  .opt {
    margin-bottom: 1.5rem;
  }

  .opt[hidden] {
    display: none;
  }

  .opt__label {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 0.7rem;
  }

  .opt__label span {
    color: var(--col-muted, #8c867c);
    font-weight: 400;
    margin-left: 0.4rem;
  }

  .size-guide {
    font-size: 0.78rem;
    color: var(--col-muted, #8c867c);
    text-decoration: underline;
    float: right;
    cursor: pointer;
  }

  .opt__select {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--col-line, #e4e1d9);
    border-radius: 8px;
    font-family: inherit;
    background: var(--color-background);
  }

  .swatches {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .swatch {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
    cursor: pointer;
    position: relative;
    /* Base fill: shows through when an inline colour is absent or an
       unrecognised colour name gets dropped by the browser. */
    background: #d8d5cd;
    background-size: cover;
  }

  .swatch.is-on {
    outline: 2px solid var(--col-ink, #1c1c1c);
    outline-offset: 3px;
  }

  /* Group swatches are links to the sibling colour's product page. */
  a.swatch {
    display: block;
    text-decoration: none;
  }

  a.swatch:hover {
    outline: 1px solid var(--col-line, #e4e1d9);
    outline-offset: 3px;
  }

  .swatch.is-none {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .sizes {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .size {
    min-width: 52px;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--col-line, #e4e1d9);
    background: var(--color-background);
    border-radius: 8px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.88rem;
    text-align: center;
    transition: 0.15s;
  }

  .size:hover {
    border-color: var(--col-ink, #1c1c1c);
  }

  .size.is-on {
    background: var(--col-ink, #1c1c1c);
    color: #fff;
    border-color: var(--col-ink, #1c1c1c);
  }

  .size.is-out,
  .size.is-none {
    color: var(--col-muted, #8c867c);
    text-decoration: line-through;
    cursor: not-allowed;
    background: #f1efe9;
  }

  /* ===== BUY BAR ===== */
  .buybar {
    display: flex;
    gap: 0.8rem;
    align-items: stretch;
    margin: 1.8rem 0 1rem;
  }

  .qty {
    display: flex;
    align-items: center;
    border: 1px solid var(--col-line, #e4e1d9);
    border-radius: 10px;
    background: var(--color-background);
  }

  .qty__btn {
    width: 44px;
    border: 0;
    background: none;
    font-size: 1.2rem;
    cursor: pointer;
    color: var(--color-foreground);
  }

  .qty__input {
    width: 42px;
    text-align: center;
    border: 0;
    font-family: inherit;
    font-size: 1rem;
    background: none;
    -moz-appearance: textfield;
  }

  .qty__input::-webkit-outer-spin-button,
  .qty__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .atc {
    flex: 1;
    border: 0;
    border-radius: 10px;
    background: var(--col-ink, #1c1c1c);
    color: #fff;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 1rem;
    cursor: pointer;
    transition: 0.2s;
  }

  .atc:hover:not(:disabled) {
    background: #000;
  }

  .atc[aria-busy='true'] {
    opacity: 0.75;
    cursor: progress;
  }

  .atc:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Shopify dynamic checkout button */
  .product-form .shopify-payment-button {
    margin-bottom: 0.7rem;
  }

  .product-form .shopify-payment-button__button {
    border-radius: 10px;
    font-family: inherit;
    font-weight: 600;
  }

  .product-form .shopify-payment-button__button--unbranded {
    background: var(--col-accent, #5b6b96);
    color: #fff;
  }

  .product-form .shopify-payment-button__button--unbranded:hover:not([disabled]) {
    filter: brightness(1.08);
  }

  .paylater {
    text-align: center;
    font-size: 0.8rem;
    color: var(--col-muted, #8c867c);
    margin: 0 0 1.5rem;
  }

  /* ===== TRUST ===== */
  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    padding: 1.2rem 0;
    border-top: 1px solid var(--col-line, #e4e1d9);
    border-bottom: 1px solid var(--col-line, #e4e1d9);
    margin-bottom: 1.5rem;
  }

  .trust div {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--col-body, #4a463f);
  }

  .trust svg {
    width: 20px;
    height: 20px;
    stroke: var(--col-accent, #5b6b96);
  }

  /* ===== COMBO CONTENTS ===== */
  .combo {
    border: 1px solid var(--col-line, #e4e1d9);
    border-radius: 12px;
    padding: 1.1rem 1.2rem;
    margin-bottom: 1.5rem;
    background: var(--color-background);
  }

  .combo__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.9rem;
  }

  .combo__title {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .combo__count {
    font-size: 0.75rem;
    color: var(--col-muted, #8c867c);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .combo__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .combo__link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--col-ink, #1c1c1c);
  }

  .combo__media {
    flex: 0 0 auto;
    width: 52px;
    aspect-ratio: 3 / 4;
    border-radius: 6px;
    overflow: hidden;
    background: var(--col-media, #e9e6df);
  }

  .combo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .combo__info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .combo__name {
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .combo__link:hover .combo__name {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .combo__price {
    font-size: 0.8rem;
    color: var(--col-muted, #8c867c);
  }

  .combo__savings {
    margin: 1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--col-line, #e4e1d9);
    font-size: 0.9rem;
  }

  .combo__was {
    color: var(--col-muted, #8c867c);
    text-decoration: line-through;
    margin-left: 0.4rem;
  }

  .combo__save {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    background: #4f7a4f;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
  }

  /* ===== ACCORDIONS ===== */
  .acc {
    border-bottom: 1px solid var(--col-line, #e4e1d9);
  }

  .acc > summary {
    list-style: none;
    cursor: pointer;
    padding: 1.1rem 0;
    font-weight: 600;
    font-size: 0.95rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .acc > summary::-webkit-details-marker {
    display: none;
  }

  .acc > summary::after {
    content: "+";
    color: var(--col-muted, #8c867c);
    font-weight: 400;
    font-size: 1.2rem;
  }

  .acc[open] > summary::after {
    content: "–";
  }

  .acc__body {
    padding: 0 0 1.2rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--col-body, #4a463f);
  }

  .acc__body ul {
    margin: 0.4rem 0;
    padding-left: 1.1rem;
  }

  /* ===== RELATED ===== */
  .related {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin) 4rem;
  }

  .related h2 {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    margin: 0 0 1.5rem;
  }

  .rgrid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.8rem);
  }

  /* Mirrors the product cards on the collection page so "You may also like"
     reads as the same component (no default link blue/underline). */
  .rcard {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .rcard__media {
    border-radius: 10px;
    overflow: hidden;
    background: var(--col-media, #e9e6df);
    aspect-ratio: 3 / 4;
  }

  .rcard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .rcard:hover .rcard__img {
    transform: scale(1.04);
  }

  .rcard__info {
    padding: 0.85rem 0.1rem 0;
  }

  .rcard__title {
    font-family: var(--font-product);
    font-weight: 400;
    font-size: 1.15rem;
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }

  .rcard__price {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    margin: 0;
  }

  .rcard__price .was {
    color: var(--col-muted, #8c867c);
    font-weight: 400;
    text-decoration: line-through;
    margin-left: 0.4rem;
    font-size: 0.85rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .pdp__grid {
      grid-template-columns: 1fr;
    }
    .gallery--sticky {
      position: static;
    }
    .rgrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .gallery {
      grid-template-columns: 1fr;
    }
    .gallery__thumbs {
      flex-direction: row;
      order: 2;
      overflow-x: auto;
    }
    .gallery__thumb {
      width: 64px;
      flex: 0 0 auto;
    }
  }
{% endstylesheet %}

