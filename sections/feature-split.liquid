{%- liquid
  assign btn_bg = section.settings.button_background_color
  if btn_bg == blank
    assign btn_bg = 'var(--color-button-background)'
  endif
  assign btn_text = section.settings.button_text_color
  if btn_text == blank
    assign btn_text = 'var(--color-button-text)'
  endif
-%}
<div
  class="split full-width"
  data-side="{{ section.settings.image_side }}"
  style="--split-height: {{ section.settings.image_height }}vh; --split-heading-color: {{ section.settings.heading_color }}; --split-btn-bg: {{ btn_bg }}; --split-btn-text: {{ btn_text }};"
>
  <div class="split__media">
    <div class="split__image-wrap">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: widths: '600, 900, 1200, 1600', class: 'split__image', alt: section.settings.heading
        }}
      {% elsif section.settings.image_asset != blank %}
        {{ section.settings.image_asset | asset_url | image_tag: class: 'split__image', alt: section.settings.heading }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'split__image split__image--placeholder' }}
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="split__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url }}" class="button split__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

  <div class="split__spacer" aria-hidden="true"></div>
</div>

{% stylesheet %}
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-color: var(--color-background);
  }

  /* When the image should sit on the right, swap the columns. */
  .split[data-side='right'] .split__media {
    order: 2;
  }
  .split[data-side='right'] .split__spacer {
    order: 1;
  }

  .split__media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 2rem;
  }

  .split__image-wrap {
    position: relative;
    width: 100%;
    height: var(--split-height, 85vh);
  }

  .split__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__image--placeholder {
    background-color: #e7e4dd;
  }

  .split__heading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 1rem;
    text-align: center;
    color: var(--split-heading-color, #f4f1e9);
    font-size: clamp(2.5rem, 6vw, 5rem);
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.25);
  }

  .split__button {
    background-color: var(--split-btn-bg);
    color: var(--split-btn-text);
  }

  /* On small screens the empty white column collapses and the image stacks full-width. */
  @media (max-width: 749px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split__spacer {
      display: none;
    }
    .split__image-wrap {
      height: 70vh;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Split feature",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image asset filename (fallback)",
      "info": "Filename of an image in assets/ (e.g. feature-9012.jpg). Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (over image)",
      "default": "The Dependable Returns"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#f4f1e9"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left (white space on right)" },
        { "value": "right", "label": "Right (white space on left)" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Image height",
      "default": 85
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background (optional)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text (optional)"
    }
  ],
  "presets": [
    {
      "name": "Split feature"
    }
  ]
}
{% endschema %}
