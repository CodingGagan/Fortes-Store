{%- liquid
  assign btn_bg = section.settings.button_background_color
  if btn_bg == blank
    assign btn_bg = 'var(--color-button-background)'
  endif
  assign btn_text = section.settings.button_text_color
  if btn_text == blank
    assign btn_text = 'var(--color-button-text)'
  endif
  assign linked_product = section.settings.product
  assign btn_url = section.settings.button_url
  if btn_url == blank and linked_product != blank
    assign btn_url = linked_product.url
  endif
  assign section_url = linked_product.url | default: section.settings.button_url
  assign section_bg = section.settings.background_color
  if section_bg == blank
    assign section_bg = 'var(--color-background)'
  endif
-%}
<div
  class="split full-width{% if section.settings.width == 'half' %} split--half{% endif %}{% if section_url != blank %} has-link{% endif %}"
  data-side="{{ section.settings.image_side }}"
  style="--split-height: {{ section.settings.image_height }}vh; --split-bg: {{ section_bg }}; --split-heading-color: {{ section.settings.heading_color }}; --split-btn-bg: {{ btn_bg }}; --split-btn-text: {{ btn_text }}; --split-gradient-color: {{ section.settings.gradient_color }}; --split-gradient-height: {{ section.settings.gradient_height }}%; --split-btn-offset: {{ section.settings.button_offset }}%;"
>
  <div class="split__media">
    <div class="split__image-wrap">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: widths: '600, 900, 1200, 1600', class: 'split__image', alt: section.settings.heading
        }}
      {% elsif section.settings.image_asset != blank %}
        <img
          src="{{ section.settings.image_asset | asset_url }}"
          class="split__image"
          alt="{{ section.settings.heading | escape }}"
          width="{{ section.settings.image_asset_width | default: 4000 }}"
          height="{{ section.settings.image_asset_height | default: 6000 }}"
          loading="lazy"
        >
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'split__image split__image--placeholder' }}
      {% endif %}

      {% if section.settings.show_gradient %}
        <div class="split__gradient" aria-hidden="true"></div>
      {% endif %}

      {% if section_url != blank %}
        <a
          class="split__link"
          href="{{ section_url }}"
          aria-label="{{ section.settings.heading | default: linked_product.title | default: 'View product' | escape }}"
        ></a>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="split__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.button_label != blank and btn_url != blank %}
        <a
          href="{{ btn_url }}"
          class="button split__button"
          data-style="{{ section.settings.button_style }}"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="split__spacer" aria-hidden="true"></div>
</div>

{% stylesheet %}
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-color: var(--split-bg, var(--color-background));
  }

  /**
   * Half width: the section drops to one track of the body grid, so it pairs
   * up with the neighbouring half section to share a row. Inside, the empty
   * spacer column goes away and the image takes the whole section.
   *
   * The image measures 50vw either way — full width split 50/50 with the
   * spacer, or half width with no spacer — so the heading, gradient and
   * button keep exactly the proportions they have in the full-width layout.
   */
  .shopify-section:has(> .split--half) {
    grid-column: span 1;
  }

  .split--half {
    grid-template-columns: 1fr;
  }

  .split--half .split__spacer {
    display: none;
  }

  /* When the image should sit on the right, swap the columns. */
  .split[data-side='right'] .split__media {
    order: 2;
  }
  .split[data-side='right'] .split__spacer {
    order: 1;
  }

  .split__image-wrap {
    position: relative;
    width: 100%;
    height: var(--split-height, 85vh);
  }

  .split__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__image--placeholder {
    background-color: #e7e4dd;
  }

  /* Color rising from the bottom of the image. */
  .split__gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--split-gradient-height, 45%);
    background: linear-gradient(to top, var(--split-gradient-color, #4d4631) 0%, transparent 100%);
    pointer-events: none;
  }

  /* Whole-image click target (sits above image/gradient, below heading + CTA). */
  .split__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .split__heading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 1rem;
    text-align: center;
    color: var(--split-heading-color, #f4f1e9);
    font-size: clamp(2.5rem, 6vw, 5rem);
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }

  /* Button overlaid on the image, centered near the bottom. */
  .split__button {
    position: absolute;
    left: 50%;
    bottom: var(--split-btn-offset, 14%);
    transform: translateX(-50%);
    z-index: 2;
    white-space: nowrap;
  }

  .split__button[data-style='solid'] {
    background-color: var(--split-btn-bg);
    color: var(--split-btn-text);
    border: none;
  }

  .split__button[data-style='outline'] {
    background-color: transparent;
    color: var(--split-btn-text);
    border: 1px solid var(--split-btn-text);
  }

  /* On small screens the empty white column collapses and the image stacks full-width. */
  @media (max-width: 749px) {
    /* Paired sections stop sharing a row and stack full-width like the rest. */
    .shopify-section:has(> .split--half) {
      grid-column: 1 / -1;
    }

    .split {
      grid-template-columns: 1fr;
    }
    .split__spacer {
      display: none;
    }
    .split__image-wrap {
      height: 70vh;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Split feature",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "info": "Set two neighbouring sections to Half and they sit side by side in one row, each filling its half with its image. Stacks full-width on mobile.",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "half", "label": "Half (pairs with neighbour)" }
      ],
      "default": "full"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image asset filename (fallback)",
      "info": "Filename of an image in assets/ (e.g. feature-9012.jpg). Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (over image)",
      "default": "The Dependable Returns"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#f4f1e9"
    },
    {
      "visible_if": "{{ section.settings.width == 'full' }}",
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "info": "Fills the empty column beside the image. Leave blank to use the theme background."
    },
    {
      "visible_if": "{{ section.settings.width == 'full' }}",
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left (white space on right)" },
        { "value": "right", "label": "Right (white space on left)" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Image height",
      "default": 85
    },
    {
      "type": "header",
      "content": "Bottom gradient"
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Show color from bottom of image",
      "default": true
    },
    {
      "type": "color",
      "id": "gradient_color",
      "label": "Gradient color",
      "default": "#4d4631"
    },
    {
      "type": "range",
      "id": "gradient_height",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Gradient height",
      "default": 45
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Linked product",
      "info": "The section image and button link to this product's page."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link (override)",
      "info": "Optional. Leave blank to use the linked product above."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "outline"
    },
    {
      "type": "range",
      "id": "button_offset",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Button position from bottom",
      "default": 14
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background (solid style)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text / border"
    }
  ],
  "presets": [
    {
      "name": "Split feature"
    }
  ]
}
{% endschema %}
