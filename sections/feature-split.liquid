{%- liquid
  assign btn_bg = section.settings.button_background_color
  if btn_bg == blank
    assign btn_bg = 'var(--color-button-background)'
  endif
  assign btn_text = section.settings.button_text_color
  if btn_text == blank
    assign btn_text = 'var(--color-button-text)'
  endif
-%}
<div
  class="split full-width"
  data-side="{{ section.settings.image_side }}"
  style="--split-height: {{ section.settings.image_height }}vh; --split-heading-color: {{ section.settings.heading_color }}; --split-btn-bg: {{ btn_bg }}; --split-btn-text: {{ btn_text }}; --split-gradient-color: {{ section.settings.gradient_color }}; --split-gradient-height: {{ section.settings.gradient_height }}%; --split-btn-offset: {{ section.settings.button_offset }}%;"
>
  <div class="split__media">
    <div class="split__image-wrap">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: widths: '600, 900, 1200, 1600', class: 'split__image', alt: section.settings.heading
        }}
      {% elsif section.settings.image_asset != blank %}
        <img
          src="{{ section.settings.image_asset | asset_url }}"
          class="split__image"
          alt="{{ section.settings.heading | escape }}"
          width="{{ section.settings.image_asset_width | default: 4000 }}"
          height="{{ section.settings.image_asset_height | default: 6000 }}"
          loading="lazy"
        >
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'split__image split__image--placeholder' }}
      {% endif %}

      {% if section.settings.show_gradient %}
        <div class="split__gradient" aria-hidden="true"></div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="split__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_url }}"
          class="button split__button"
          data-style="{{ section.settings.button_style }}"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="split__spacer" aria-hidden="true"></div>
</div>

{% stylesheet %}
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-color: var(--color-background);
  }

  /* When the image should sit on the right, swap the columns. */
  .split[data-side='right'] .split__media {
    order: 2;
  }
  .split[data-side='right'] .split__spacer {
    order: 1;
  }

  .split__image-wrap {
    position: relative;
    width: 100%;
    height: var(--split-height, 85vh);
  }

  .split__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__image--placeholder {
    background-color: #e7e4dd;
  }

  /* Color rising from the bottom of the image. */
  .split__gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--split-gradient-height, 45%);
    background: linear-gradient(to top, var(--split-gradient-color, #4d4631) 0%, transparent 100%);
    pointer-events: none;
  }

  .split__heading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 1rem;
    text-align: center;
    color: var(--split-heading-color, #f4f1e9);
    font-size: clamp(2.5rem, 6vw, 5rem);
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.25);
  }

  /* Button overlaid on the image, centered near the bottom. */
  .split__button {
    position: absolute;
    left: 50%;
    bottom: var(--split-btn-offset, 14%);
    transform: translateX(-50%);
    z-index: 2;
    white-space: nowrap;
  }

  .split__button[data-style='solid'] {
    background-color: var(--split-btn-bg);
    color: var(--split-btn-text);
    border: none;
  }

  .split__button[data-style='outline'] {
    background-color: transparent;
    color: var(--split-btn-text);
    border: 1px solid var(--split-btn-text);
  }

  /* On small screens the empty white column collapses and the image stacks full-width. */
  @media (max-width: 749px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split__spacer {
      display: none;
    }
    .split__image-wrap {
      height: 70vh;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Split feature",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image asset filename (fallback)",
      "info": "Filename of an image in assets/ (e.g. feature-9012.jpg). Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (over image)",
      "default": "The Dependable Returns"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#f4f1e9"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left (white space on right)" },
        { "value": "right", "label": "Right (white space on left)" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Image height",
      "default": 85
    },
    {
      "type": "header",
      "content": "Bottom gradient"
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Show color from bottom of image",
      "default": true
    },
    {
      "type": "color",
      "id": "gradient_color",
      "label": "Gradient color",
      "default": "#4d4631"
    },
    {
      "type": "range",
      "id": "gradient_height",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Gradient height",
      "default": 45
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "outline"
    },
    {
      "type": "range",
      "id": "button_offset",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Button position from bottom",
      "default": 14
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background (solid style)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text / border"
    }
  ],
  "presets": [
    {
      "name": "Split feature"
    }
  ]
}
{% endschema %}
