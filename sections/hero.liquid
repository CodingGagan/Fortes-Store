{%- liquid
  assign bg = section.settings.background_color
-%}
<div
  class="hero full-width"
  style="--hero-bg: {{ bg }}; --hero-text: {{ section.settings.text_color }};"
>
  <div class="hero__content">
    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag: widths: '400, 600, 800, 1200, 1600', class: 'hero__image', alt: section.settings.heading
      }}
    {% elsif section.settings.image_asset != blank %}
      {{ section.settings.image_asset | asset_url | image_tag: class: 'hero__image', alt: section.settings.heading }}
    {% else %}
      <div class="hero__image hero__image--placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url }}" class="button hero__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero {
    background-color: var(--hero-bg, #eef0ec);
    color: var(--hero-text, inherit);
    display: grid;
    grid-template-columns: var(--content-grid);
    padding: 4rem 0 5rem;
  }

  .hero__content {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }

  .hero__heading {
    font-size: clamp(3rem, 9vw, 7rem);
    margin: 0;
  }

  .hero__image {
    max-width: 540px;
    width: 100%;
  }

  .hero__image--placeholder svg {
    width: 100%;
    height: auto;
    opacity: 0.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stripes!"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image asset filename (fallback)",
      "info": "Filename of an image in assets/ (e.g. hero-main.jpg). Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "New in Shop"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#eef0ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#3f6f4e"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
