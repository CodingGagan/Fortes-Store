{%- liquid
  assign hero_img = section.settings.hero_image
  assign hero_asset = section.settings.hero_image_asset
  assign mission_img = section.settings.mission_image
  assign mission_asset = section.settings.mission_image_asset
-%}
<div
  class="about"
  style="--about-dark: {{ section.settings.dark_color }}; --about-cream: {{ section.settings.cream_color }}; --about-accent: {{ section.settings.accent_color }};"
>
  {%- comment -%} ---------- Hero band ---------- {%- endcomment -%}
  <section class="about-hero full-width" style="--about-hero-height: {{ section.settings.hero_height }}vh;">
    {% if hero_img != blank %}
      {{
        hero_img
        | image_url: width: 2400
        | image_tag: widths: '800, 1200, 1600, 2000, 2400', class: 'about-hero__image', alt: section.settings.hero_heading
      }}
    {% elsif hero_asset != blank %}
      <img
        src="{{ hero_asset | asset_url }}"
        class="about-hero__image"
        alt="{{ section.settings.hero_heading | escape }}"
        width="1920"
        height="1280"
      >
    {% else %}
      <div class="about-hero__image about-hero__image--placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}

    <div class="about-hero__overlay" aria-hidden="true"></div>

    <div class="about-hero__content">
      {% if section.settings.hero_kicker != blank %}
        <p class="about-hero__kicker">{{ section.settings.hero_kicker }}</p>
      {% endif %}
      {% if section.settings.hero_heading != blank %}
        <h1 class="about-hero__heading">{{ section.settings.hero_heading }}</h1>
      {% endif %}
    </div>
  </section>

  {%- comment -%} ---------- Brand story ---------- {%- endcomment -%}
  <section class="about-story">
    <div class="about-story__inner">
      {{ section.settings.story_richtext }}
    </div>
  </section>

  {%- comment -%} ---------- What we stand for ---------- {%- endcomment -%}
  <section class="about-values full-width">
    <div class="about-values__inner">
      {% if section.settings.values_heading != blank %}
        <h2 class="about__section-heading">{{ section.settings.values_heading }}</h2>
      {% endif %}
      <div class="about-values__grid">
        {% for block in section.blocks %}
          {% if block.type == 'value' %}
            <div class="about-value" {{ block.shopify_attributes }}>
              <span class="about-value__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="about-value__title">{{ block.settings.title }}</h3>
              <p class="about-value__text">{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- Our mission (split) ---------- {%- endcomment -%}
  <section class="about-mission full-width" data-side="{{ section.settings.mission_image_side }}">
    <div class="about-mission__media">
      {% if mission_img != blank %}
        {{
          mission_img
          | image_url: width: 1600
          | image_tag: widths: '600, 900, 1200, 1600', class: 'about-mission__image', alt: section.settings.mission_heading
        }}
      {% elsif mission_asset != blank %}
        <img
          src="{{ mission_asset | asset_url }}"
          class="about-mission__image"
          alt="{{ section.settings.mission_heading | escape }}"
          width="1200"
          height="1500"
          loading="lazy"
        >
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'about-mission__image about-mission__image--placeholder' }}
      {% endif %}
    </div>
    <div class="about-mission__body">
      <div class="about-mission__body-inner">
        {% if section.settings.mission_heading != blank %}
          <h2 class="about__section-heading">{{ section.settings.mission_heading }}</h2>
        {% endif %}
        <div class="about-mission__text">{{ section.settings.mission_text }}</div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- From the founder ---------- {%- endcomment -%}
  <section class="about-founder full-width">
    <div class="about-founder__inner">
      {% if section.settings.founder_label != blank %}
        <p class="about-founder__label">{{ section.settings.founder_label }}</p>
      {% endif %}
      {% if section.settings.founder_quote != blank %}
        <blockquote class="about-founder__quote">{{ section.settings.founder_quote }}</blockquote>
      {% endif %}
      {% if section.settings.founder_signature != blank %}
        <p class="about-founder__signature">{{ section.settings.founder_signature }}</p>
      {% endif %}
    </div>
  </section>
</div>

{% stylesheet %}
  .about {
    --about-dark: #4d4631;
    --about-cream: #f4f1e9;
    --about-accent: #b8a06a;
    background-color: var(--about-cream);
    color: #2a2620;
    font-family: var(--font-body, 'Montserrat', sans-serif);
  }

  .about__section-heading {
    margin: 0 0 1.5rem;
    font-family: var(--font-display, 'Anton', sans-serif);
    font-weight: 400;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    line-height: 1;
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  /* ---------- Hero ---------- */
  .about-hero {
    position: relative;
    height: var(--about-hero-height, 70vh);
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    color: var(--about-cream);
  }

  .about-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-hero__image--placeholder {
    background-color: #e7e4dd;
  }

  .about-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.15) 55%, rgba(0, 0, 0, 0.25) 100%);
  }

  .about-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 4rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .about-hero__kicker {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .about-hero__heading {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display, 'Anton', sans-serif);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.98;
    font-size: clamp(2.5rem, 8vw, 6rem);
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.3);
  }

  /* ---------- Story ---------- */
  .about-story {
    padding: clamp(3.5rem, 9vw, 7rem) clamp(1.5rem, 5vw, 4rem);
  }

  .about-story__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .about-story__inner p {
    margin: 0 0 1.5rem;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.6;
  }

  .about-story__inner p:first-child {
    font-family: var(--font-product, 'Ovo', serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.5;
  }

  .about-story__inner p:last-child {
    margin-bottom: 0;
  }

  .about-story__inner strong {
    color: var(--about-dark);
  }

  /* ---------- Values ---------- */
  .about-values {
    background-color: var(--about-dark);
    color: var(--about-cream);
    padding: clamp(3.5rem, 9vw, 7rem) clamp(1.5rem, 5vw, 4rem);
  }

  .about-values__inner {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    text-align: center;
  }

  .about-values .about__section-heading {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    text-align: left;
  }

  .about-value {
    padding-top: 1.5rem;
    border-top: 2px solid var(--about-accent);
  }

  .about-value__num {
    display: block;
    margin-bottom: 1rem;
    font-family: var(--font-display, 'Anton', sans-serif);
    font-size: 1.4rem;
    color: var(--about-accent);
  }

  .about-value__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display, 'Anton', sans-serif);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .about-value__text {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    opacity: 0.88;
  }

  /* ---------- Mission (split) ---------- */
  .about-mission {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .about-mission[data-side='right'] .about-mission__media {
    order: 2;
  }

  .about-mission__media {
    position: relative;
    min-height: 60vh;
  }

  .about-mission__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-mission__image--placeholder {
    background-color: #e7e4dd;
  }

  .about-mission__body {
    display: flex;
    align-items: center;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 5vw, 4.5rem);
  }

  .about-mission__body-inner {
    max-width: 46ch;
  }

  .about-mission__text {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .about-mission__text p {
    margin: 0 0 1.25rem;
  }

  .about-mission__text p:last-child {
    margin-bottom: 0;
  }

  /* ---------- Founder ---------- */
  .about-founder {
    background-color: var(--about-cream);
    padding: clamp(4rem, 10vw, 8rem) clamp(1.5rem, 5vw, 4rem);
  }

  .about-founder__inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .about-founder__label {
    margin: 0 0 2rem;
    font-size: 0.85rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--about-accent);
  }

  .about-founder__quote {
    margin: 0;
    font-family: var(--font-product, 'Ovo', serif);
    font-size: clamp(1.5rem, 3.4vw, 2.4rem);
    line-height: 1.45;
    color: var(--about-dark);
  }

  .about-founder__signature {
    margin: 2.25rem 0 0;
    font-family: var(--font-display, 'Anton', sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.1rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 749px) {
    .about-values__grid {
      grid-template-columns: 1fr;
    }
    .about-mission {
      grid-template-columns: 1fr;
    }
    .about-mission[data-side='right'] .about-mission__media {
      order: 0;
    }
    .about-mission__media {
      min-height: 55vh;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About page",
  "settings": [
    {
      "type": "header",
      "content": "Palette"
    },
    {
      "type": "color",
      "id": "dark_color",
      "label": "Dark / earthy",
      "default": "#4d4631"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream / background",
      "default": "#f4f1e9"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#b8a06a"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_kicker",
      "label": "Kicker",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading",
      "default": "Every individual is a hero in their own journey"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_asset",
      "label": "Hero image asset (fallback)",
      "info": "Filename of an image in assets/ (e.g. hero-main.jpg).",
      "default": "hero-main.jpg"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Hero height",
      "default": 70
    },
    {
      "type": "header",
      "content": "Brand story"
    },
    {
      "type": "richtext",
      "id": "story_richtext",
      "label": "Story",
      "default": "<p>Fortes was born out of a simple but powerful belief: every individual is a hero in their own journey. Life is never easy. It bends us, tests us, and at times, breaks us. But within every struggle lies the seed of strength. Fortes was created as a tribute to that strength—to remind you that no matter what life throws at you, resilience is always within your reach.</p><p>For us, Fortes is not just a brand. It's a movement of courage. A lifestyle that says <strong>you are stronger than you think.</strong></p>"
    },
    {
      "type": "header",
      "content": "What we stand for"
    },
    {
      "type": "text",
      "id": "values_heading",
      "label": "Heading",
      "default": "What We Stand For"
    },
    {
      "type": "header",
      "content": "Our mission"
    },
    {
      "type": "text",
      "id": "mission_heading",
      "label": "Heading",
      "default": "Our Mission"
    },
    {
      "type": "richtext",
      "id": "mission_text",
      "label": "Text",
      "default": "<p>To design clothing that inspires and empowers. Every product we create is more than apparel—it's a symbol of courage, crafted with purpose and designed to remind you of your inner strength.</p>"
    },
    {
      "type": "image_picker",
      "id": "mission_image",
      "label": "Mission image"
    },
    {
      "type": "text",
      "id": "mission_image_asset",
      "label": "Mission image asset (fallback)",
      "info": "Filename of an image in assets/ (e.g. feature-9012.jpg).",
      "default": "feature-9012.jpg"
    },
    {
      "type": "select",
      "id": "mission_image_side",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "From the founder"
    },
    {
      "type": "text",
      "id": "founder_label",
      "label": "Label",
      "default": "From the Founder"
    },
    {
      "type": "textarea",
      "id": "founder_quote",
      "label": "Quote",
      "default": "I created Fortes to celebrate resilience. Not the absence of struggle, but the strength to rise again. Fortes is for everyone fighting their battles and choosing to live as the hero of their own story."
    },
    {
      "type": "text",
      "id": "founder_signature",
      "label": "Signature",
      "default": "— The Founder"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Resilience"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "The strength that comes from life's battles."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About page",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "title": "Resilience",
            "text": "The strength that comes from life's battles."
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Courage",
            "text": "The will to keep moving forward, no matter the odds."
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Everyday Heroes",
            "text": "Because true heroism lies in everyday struggles and victories."
          }
        }
      ]
    }
  ]
}
{% endschema %}
