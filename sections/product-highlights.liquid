{% comment %}
  Product highlights — stacked image + copy rows shown on every PDP.

  Each row is a block: a narrow image column on one side and a tinted copy
  panel filling the rest of the row, separated by a rule. Copy can be a
  bullet list (one item per line), rich text, or both.

  Everything (image, heading, bullets, body, side, colours) is editable in
  the theme editor. Because text/image settings accept dynamic sources, a
  merchant can also bind any row to a product metafield to vary the content
  per product while keeping one shared layout.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{%- liquid
  assign panel_bg = section.settings.panel_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
-%}

{%- if section.blocks.size > 0 -%}
  <div
    class="phl full-width"
    style="--phl-panel: {{ panel_bg }}; --phl-heading: {{ heading_color }}; --phl-text: {{ text_color }}; --phl-line: {{ section.settings.divider_color }}; --phl-line-width: {{ section.settings.divider_width }}px; --phl-media-width: {{ section.settings.image_width }}%; --phl-row-height: {{ section.settings.row_height }}px; --phl-pad-x: {{ section.settings.text_padding }}px;"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="phl__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div
        class="phl__row"
        data-side="{{ block.settings.image_position }}"
        {{ block.shopify_attributes }}
      >
        <div class="phl__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
                widths: '200, 400, 600, 800',
                sizes: '(max-width: 749px) 100vw, 25vw',
                class: 'phl__image',
                alt: block.settings.image.alt | default: block.settings.heading,
                loading: 'lazy'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'phl__image phl__image--placeholder' }}
          {%- endif -%}
        </div>

        <div class="phl__panel">
          <div class="phl__copy">
            {%- if block.settings.heading != blank -%}
              <h3 class="phl__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}

            {%- assign bullets = block.settings.bullets | strip | newline_to_br | split: '<br />' -%}
            {%- if bullets.size > 0 -%}
              <ul class="phl__list">
                {%- for bullet in bullets -%}
                  {%- assign line = bullet | strip -%}
                  {%- if line != blank -%}
                    <li>{{ line | escape }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <div class="phl__text">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .phl {
    background: var(--phl-panel, #d3ab98);
    color: var(--phl-text, #1c1c1c);
  }

  .phl__title {
    margin: 0;
    padding: 1.5rem var(--phl-pad-x, 32px) 0;
    color: var(--phl-heading, #1c1c1c);
    font-family: var(--font-product, var(--font-heading--family));
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .phl__row {
    display: grid;
    grid-template-columns: var(--phl-media-width, 17%) 1fr;
    align-items: stretch;
    min-height: var(--phl-row-height, 250px);
  }

  /* Rule between rows, matching the mockup's full-bleed divider. */
  .phl__row + .phl__row {
    border-top: var(--phl-line-width, 2px) solid var(--phl-line, #000000);
  }

  /* Image on the right flips the two columns. */
  .phl__row[data-side='right'] .phl__media {
    order: 2;
  }
  .phl__row[data-side='right'] .phl__panel {
    order: 1;
  }

  .phl__media {
    position: relative;
    overflow: hidden;
    background: var(--phl-panel, #d3ab98);
  }

  .phl__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phl__image--placeholder {
    background: rgba(0, 0, 0, 0.06);
  }

  .phl__panel {
    display: flex;
    align-items: center;
    padding: 2rem var(--phl-pad-x, 32px);
  }

  .phl__copy {
    max-width: 68ch;
  }

  .phl__heading {
    margin: 0 0 0.5rem;
    color: var(--phl-heading, #1c1c1c);
    font-family: var(--font-product, var(--font-heading--family));
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 700;
  }

  .phl__list {
    margin: 0;
    padding-left: 1.4em;
    list-style: disc;
  }

  .phl__list li {
    margin-bottom: 0.35rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .phl__list li:last-child {
    margin-bottom: 0;
  }

  .phl__text {
    line-height: 1.6;
  }

  .phl__list + .phl__text {
    margin-top: 0.75rem;
  }

  .phl__text p {
    margin: 0 0 0.75rem;
  }

  .phl__text p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 749px) {
    .phl__row,
    .phl__row[data-side='right'] {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .phl__row[data-side='right'] .phl__media,
    .phl__row[data-side='right'] .phl__panel {
      order: 0;
    }
    .phl__media {
      height: 220px;
    }
    .phl__panel {
      padding: 1.5rem 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product highlights",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Stacked image + copy rows. Add one block per row. Any text or image field can be connected to a product metafield with the dynamic-source picker so the content differs per product."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "info": "Optional. Leave blank to start straight with the first row."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Panel background",
      "default": "#d3ab98"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "divider_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Divider thickness",
      "default": 2
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Image column width",
      "default": 17
    },
    {
      "type": "range",
      "id": "row_height",
      "min": 160,
      "max": 520,
      "step": 10,
      "unit": "px",
      "label": "Row height",
      "default": 250
    },
    {
      "type": "range",
      "id": "text_padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Text side padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image side",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Material"
        },
        {
          "type": "textarea",
          "id": "bullets",
          "label": "Bullet list",
          "info": "One bullet per line. Leave blank to show only the paragraph below."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Paragraph"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product highlights",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "heading": "Material",
            "image_position": "left",
            "bullets": "Crafted with rare Suvin cotton.\nBlended with natural bamboo fibres.\nExceptionally fine and durable.\nNaturally breathable.\nPremium luxury fabric."
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "The FORTES Quality Badge",
            "image_position": "left",
            "body": "<p>The badge on every sleeve is more than a logo, it's our promise of quality. It represents premium materials, meticulous craftsmanship, and uncompromising attention to detail. When you wear the FORTES badge, you wear a standard built to last.</p>"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "Feel",
            "image_position": "left",
            "bullets": "Silky soft.\nCool against the skin.\nLightweight comfort.\nBreathable all day.\nSmooth, premium finish."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
