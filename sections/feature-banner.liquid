<div
  class="banner full-width"
  style="--banner-height: {{ section.settings.image_height }}vh; --banner-text: {{ section.settings.text_color }};"
>
  {% if section.settings.image != blank %}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag: widths: '800, 1200, 1600, 2000, 2400', class: 'banner__image', alt: section.settings.heading
    }}
  {% elsif section.settings.image_asset != blank %}
    <img
      src="{{ section.settings.image_asset | asset_url }}"
      class="banner__image"
      alt="{{ section.settings.heading | escape }}"
      width="{{ section.settings.image_asset_width | default: 1920 }}"
      height="{{ section.settings.image_asset_height | default: 1280 }}"
      loading="lazy"
    >
  {% else %}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'banner__image banner__image--placeholder' }}
  {% endif %}

  <div class="banner__overlay" data-align="{{ section.settings.content_position }}">
    {% if section.settings.heading != blank %}
      <h2 class="banner__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url }}" class="button banner__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .banner {
    position: relative;
    height: var(--banner-height, 90vh);
    color: var(--banner-text, #ffffff);
  }

  .banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner__image--placeholder {
    background-color: #c9b79a;
  }

  .banner__overlay {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .banner__overlay[data-align='top'] {
    justify-content: flex-start;
  }
  .banner__overlay[data-align='center'] {
    justify-content: center;
  }
  .banner__overlay[data-align='bottom'] {
    justify-content: flex-end;
  }

  /* Heading near the top, button pinned toward the bottom (as in the mockup). */
  .banner__heading {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.25);
  }

  .banner__button {
    margin-top: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image asset filename (fallback)",
      "info": "Filename of an image in assets/ (e.g. hero-main.jpg). Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Plain. Simple."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Heading position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section height",
      "default": 90
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "The March Tee"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
