[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n4",
        "label": "Headings"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Used on the login and account pages and on gift cards. The header keeps its own logo setting."
      },
      {
        "type": "text",
        "id": "support_email",
        "label": "Support email",
        "info": "The official contact address. Used by the footer, the contact page and the privacy, terms and return policies. Falls back to the store email if left blank.",
        "default": "support@fortes.store"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 160
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "catalog_background_color",
        "default": "#EBEDF2",
        "label": "Catalog background",
        "info": "Page background on product and collection pages. Set to the studio backdrop colour so product photos blend into the page."
      },
      {
        "type": "color",
        "id": "button_background_color",
        "default": "#3f6f4e",
        "label": "Button background"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "default": "#ffffff",
        "label": "Button text"
      },
      {
        "type": "textarea",
        "id": "color_swatch_map",
        "label": "Colour swatch map",
        "info": "One per line as “name: colour”, e.g. wine: #722f37. Used for colour swatches on product pages and collection cards when an option value has no native Shopify swatch. Unlisted names fall back to a built-in colour table, then to matching CSS colour names.",
        "default": "pista green: #b5d99c\nolive: #6b7a3a\nwine: #722f37\nburgundy: #6d071a\nmaroon: #7b1e2b\nmustard: #d5a021\nsand: #d7c9a8\ncharcoal: #36454f\ncream: #f4f0e6\nrust: #b7410e\nblush: #de8f9a\nsage: #9caf88\nforest: #22402f\ndark green: #14452f\noff white: #f2f0e6"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
